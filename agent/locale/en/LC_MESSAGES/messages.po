# English translations for agent responses.

msgid ""
msgstr "Language: en\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Aiutami a compilare questa richiesta"
msgstr "Help me fill out this request"

msgid "Domanda non trovata o scaduta."
msgstr "Question not found or expired."

msgid "Ecco le richieste che potrebbero fare al caso tuo. Seleziona quella che vuoi aprire."
msgstr "Here are some requests that may suit your needs. Select the one you want to open."

msgid "Non ho trovato richieste adatte. Prova a indicare il servizio o il documento di cui hai bisogno."
msgstr "No suitable requests found. Try specifying the service or document you need."

msgid "Ti aiuto a compilare la richiesta. Da quale campo vuoi partire?"
msgstr "I can help you fill out the request. Which field would you like to start with?"

msgid "Vuoi aiuto a compilare la richiesta «%(ticket)s»?"
msgstr "Would you like help filling out the request “%(ticket)s”?"
