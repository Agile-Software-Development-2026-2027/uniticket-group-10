{
  "name": "uniticket-assistant-widget",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "npm run type-check && node scripts/build.mjs",
    "build:widget": "npm run build",
    "type-check": "tsc --noEmit",
    "test": "npm run build && npm run build:demo && node --import tsx --test tests/*.test.mjs",
    "lint": "oxlint src demo scripts tests && oxfmt --check src demo scripts tests",
    "format": "oxfmt src demo scripts tests",
    "build:demo": "npm run type-check && node scripts/build.mjs --demo",
    "watch:widget": "node scripts/build.mjs --watch --widget"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.33",
    "@assistant-ui/react-markdown": "^0.14.25",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7",
    "@assistant-ui/react-ag-ui": "0.1.2",
    "@ag-ui/client": "1.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "29.1.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "@ag-ui/encoder": "^1.0.3"
  },
  "type": "module"
}
